# Audit Logging Configuration
# Copy this to your .env file and adjust as needed

# Enable/disable audit logging globally
AUDIT_ENABLED=true

# Log database read operations (WARNING: Can be very verbose)
AUDIT_LOG_READS=false

# Log database write operations (CREATE, UPDATE)
AUDIT_LOG_WRITES=true

# Log database delete operations
AUDIT_LOG_DELETES=true

# Log raw SQL queries (WARNING: Can be very verbose)
AUDIT_LOG_RAW_QUERIES=false

# Log bulk operations (bulk reads, bulk inserts, etc.)
AUDIT_LOG_BULK_OPERATIONS=true

# Performance settings
AUDIT_BATCH_SIZE=100
AUDIT_ASYNC_LOGGING=true
AUDIT_MAX_RETRIES=3

# Retention settings (in days)
AUDIT_RETENTION_DAYS=90
AUDIT_SENSITIVE_RETENTION_DAYS=365

# Log level for audit entries
AUDIT_LOG_LEVEL=INFO

# Maximum response size to log (bytes)
AUDIT_MAX_RESPONSE_SIZE=10000
